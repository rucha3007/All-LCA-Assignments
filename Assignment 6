#include <stdio.h>

unsigned long long factorial_recursive(int n) {
    if (n == 0 || n == 1) {
        return 1ULL;
    }
    return (unsigned long long)n * factorial_recursive(n - 1);
}

unsigned long long factorial_iterative(int n) {
    unsigned long long result = 1ULL;
    for (int i = 2; i <= n; i++) {
        result *= (unsigned long long)i;
    }
    return result;
}

int main(void) {
    int num;

    printf("Enter a non-negative integer: ");
    if (scanf("%d", &num) != 1 || num < 0) {
        printf("Invalid input. Please enter a non-negative integer.\n");
        return 1;
    }

    unsigned long long rec_fact = factorial_recursive(num);
    unsigned long long iter_fact = factorial_iterative(num);

    printf("Factorial of number=%llu (using recursion)\n", rec_fact);
    printf("Factorial of number=%llu (without recursion)\n", iter_fact);

    return 0;
}
