#include <stdio.h>

#define SUBJECTS 3
#define NAME_LEN 50

struct Student {
    int roll_no;
    char name[NAME_LEN];
    int marks[SUBJECTS];
    int total;
    float percentage;
};

int main(void) {
    int n;

    printf("Enter the number of students: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid number of students.\n");
        return 1;
    }

    struct Student students[n];

    for (int i = 0; i < n; i++) {
        printf("Enter the roll number, name and marks of 3 subjects:\n");
        scanf("%d %49s %d %d %d",
              &students[i].roll_no,
              students[i].name,
              &students[i].marks[0],
              &students[i].marks[1],
              &students[i].marks[2]);

        students[i].total = students[i].marks[0] + students[i].marks[1] + students[i].marks[2];
        students[i].percentage = (float)students[i].total / SUBJECTS;
    }

    printf("\nRoll No | Name | Subject: 1 | Subject: 2 | Subject: 3 | Total | Percentage\n\n");
    for (int i = 0; i < n; i++) {
        printf("%d | %s | %d | %d | %d | %d | %.2f\n",
               students[i].roll_no,
               students[i].name,
               students[i].marks[0],
               students[i].marks[1],
               students[i].marks[2],
               students[i].total,
               students[i].percentage);
    }

    return 0;
}
