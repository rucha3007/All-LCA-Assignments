#include <stdio.h>
#include <stdlib.h>

#define MAX_FILENAME_LEN 256

int main(void) {
    char source_name[MAX_FILENAME_LEN];
    char dest_name[MAX_FILENAME_LEN];
    FILE *src_file;
    FILE *dest_file;
    int ch;

    printf("Enter source file name: ");
    if (scanf("%255s", source_name) != 1) {
        fprintf(stderr, "Error reading source file name.\n");
        return 1;
    }

    printf("Enter destination file name: ");
    if (scanf("%255s", dest_name) != 1) {
        fprintf(stderr, "Error reading destination file name.\n");
        return 1;
    }

    src_file = fopen(source_name, "r");
    if (src_file == NULL) {
        perror("Unable to open source file");
        return 1;
    }

    dest_file = fopen(dest_name, "w");
    if (dest_file == NULL) {
        perror("Unable to open destination file");
        fclose(src_file);
        return 1;
    }

    while ((ch = fgetc(src_file)) != EOF) {
        if (fputc(ch, dest_file) == EOF) {
            perror("Error writing to destination file");
            fclose(src_file);
            fclose(dest_file);
            return 1;
        }
    }

    if (ferror(src_file)) {
        perror("Error reading source file");
        fclose(src_file);
        fclose(dest_file);
        return 1;
    }

    fclose(src_file);
    fclose(dest_file);

    printf("File contents copied successfully from '%s' to '%s'.\n", source_name, dest_name);
    return 0;
}
